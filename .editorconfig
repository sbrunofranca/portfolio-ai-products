# EditorConfig é útil para manter consistência de estilos de código
# entre diferentes IDEs e editores de texto
# https://editorconfig.org

root = true

# Configuração padrão para todos os arquivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Bash files
[*.{sh,bash}]
indent_style = space
indent_size = 4

# Makefile
[Makefile]
indent_style = tab

# Ignore node modules
[node_modules/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
