# ===========================================================================
# CONFIGURAÇÃO DE AMBIENTE - TEMPLATE
# ===========================================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na raiz de cada projeto
# 2. Preencha os valores conforme necessário
# 3. NUNCA commite .env no repositório
# 4. Use para desenvolvimento local apenas
#
# ===========================================================================

# ===== AMBIENTE GERAL =====
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=DEBUG

# ===== ANTHROPIC / CLAUDE API =====
ANTHROPIC_API_KEY=sk_...your_api_key_here...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== BANCO DE DADOS =====
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
# Ou SQLite para desenvolvimento
# DATABASE_URL=sqlite:///./test.db

# ===== REDIS (Cache/Queue) =====
REDIS_URL=redis://localhost:6379/0

# ===== AUTENTICAÇÃO =====
SECRET_KEY=seu-chave-secreta-super-secreta-aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===== OAUTH (Opcional) =====
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# ===== SERVIDOR WEB (FastAPI) =====
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ===== EMAIL =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
EMAIL_FROM=noreply@example.com

# ===== AWS (Se usado) =====
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=seu-bucket

# ===== APIS EXTERNAS =====
STRIPE_API_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

OPENAI_API_KEY=...  # Se usado junto com Anthropic

# ===== LOGGING =====
LOG_FILE=logs/app.log
LOG_FORMAT=json

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ===== CACHE =====
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ===== FEATURE FLAGS =====
ENABLE_NEW_FEATURE=False
ENABLE_BETA_API=False

# ===== SENTRY (Error Tracking) =====
SENTRY_DSN=https://...@sentry.io/...

# ===== SLACK (Notificações) =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#notifications

# ===== CUSTOM PROJECT SETTINGS =====
# Adicione configurações específicas do seu projeto aqui
PROJECT_NAME=portfolio-ai-products
PROJECT_VERSION=1.0.0-alpha
TIMEZONE=America/Sao_Paulo
